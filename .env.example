# ============================================================
# 🏨 DOWNTOWN VILLA v2 — ENVIRONMENT
# ============================================================
# Copy this to .env and fill in your values.
# ============================================================

# ── Bot connection (REQUIRED) ──
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
SESSION=downtown_villa

# ── Atlas disk monitoring (optional; API key with Project Read Only access) ──
ATLAS_API_PUBLIC_KEY=
ATLAS_API_PRIVATE_KEY=
# Shared project ID; per-shard overrides use ATLAS_PROJECT_ID_MEDIA_01, etc.
ATLAS_PROJECT_ID=
# ATLAS_PROJECT_ID_SYSTEM_01=
# ATLAS_PROJECT_ID_USER_01=
# ATLAS_PROJECT_ID_MEDIA_01=

# ── Admins (space-separated user IDs) ──
ADMINS=123456789 987654321

# ── Log + channels ──
LOG_CHANNEL=-1001234567890
REQST_CHANNEL=-1001234567890
BROADCAST_CHANNEL_ID=-1001234567890
MOVIE_UPDATE_CHANNEL=-1001234567890
DATABASE_CHANNEL_IDS=-1001111111111 -1002222222222

# ── Server ──
PORT=8080

# ── SYSTEM database shards ──
SYSTEM_DATABASE_01=mongodb+srv://user:pass@cluster1.mongodb.net/?retryWrites=true&w=majority
SYSTEM_DATABASE_NAME_01=SYSTEM-01
# SYSTEM_DATABASE_02=mongodb+srv://...
# SYSTEM_DATABASE_NAME_02=SYSTEM-02
SYSTEM_DATABASE_DB=downtown_villa_system

# ── USER database shards ──
USER_DATABASE_01=mongodb+srv://user:pass@cluster2.mongodb.net/?retryWrites=true&w=majority
USER_DATABASE_NAME_01=USERS-01
# USER_DATABASE_02=...
USER_DATABASE_DB=downtown_villa_user

# ── MEDIA database shards ──
MEDIA_DATABASE_01=mongodb+srv://user:pass@cluster3.mongodb.net/?retryWrites=true&w=majority
MEDIA_DATABASE_NAME_01=MEDIA-01
# MEDIA_DATABASE_02=...
MEDIA_DATABASE_DB=downtown_villa_media

# ── BACKUP database shards ──
BACKUP_DATABASE_01=mongodb+srv://user:pass@cluster4.mongodb.net/?retryWrites=true&w=majority
BACKUP_DATABASE_NAME_01=BACKUP-01
# BACKUP_DATABASE_02=...
BACKUP_DATABASE_DB=downtown_villa_backup

# ── Metadata providers ──
TMDB_API_KEY=your_tmdb_key
OMDB_API_KEY=
METADATA_PROVIDER=tmdb

# ── Channels / links ──
AUTH_CHANNELS=
UPDATE_CHNL_LNK=https://t.me/your_channel
SUPPORT_CHAT=https://t.me/your_support
OWNER_LNK=https://t.me/your_username
GRP_LNK=https://t.me/your_group

# ── Backup tuning ──
BACKUP_CHANNEL_ID=-1001234567890
BACKUP_STORAGE_CHANNEL_ID=
BACKUP_AUTO_START=true
BACKUP_WATCH_INTERVAL=5
BACKUP_UPLOAD_DELAY=0.5
BACKUP_MAX_RETRIES=8
BACKUP_SMART_RESUME_HOURS=48

# ── Indexing tuning ──
AUTO_INDEXING_ENABLED=true
# Used storage (data + indexes) limit per MEDIA shard; indexing fills DB 01,
# then automatically routes new files to DB 02, DB 03, and so on.
INDEXING_THRESHOLD_MB=400

# ── OTT tuning ──
OTT_REGION=IN
OTT_RELEASE_TIME=12:00
OTT_LANG=en-US

# ── Search tuning ──
SEARCH_PAGE_SIZE=10
MAX_SEARCH_RESULTS=200
SEARCH_SESSION_TTL=1800
SHARD_TIMEOUT=6
SHARD_CONCURRENCY=10
SPELL_CHECK_THRESHOLD=85
MAX_LIST_ELM=10

# ── Preferred release ──
PREFERRED_QUALITY=1080p
PREFERRED_CODEC=HEVC
PREFERRED_AUDIO=ENGLISH
PREFERRED_SUBTITLE=ENGLISH

# ── Auto-delete ──
AUTO_DELETE_ENABLED=true
AUTO_DELETE_MINUTES=10

# ── Force-sub ──
FORCE_SUB_ENABLED=false

# ── Feature flags ──
PM_SEARCH_ENABLED=true
MAINTENANCE_MODE=false

# ── Legacy storage fallback (not actual Atlas quota) ──
DB_CAPACITY_MB=512
